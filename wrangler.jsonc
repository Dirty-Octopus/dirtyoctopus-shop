{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dirtyoctopus-shop-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-worker",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "ENVIRONMENT": "production",
    "ACCESS_TEAM_DOMAIN": "https://noisy-base-4a50.cloudflareaccess.com",
    "ACCESS_AUD": "7e58b53b7ae6ad5e274283857a412cb1a173b906c267eacd18f9aab4fd61c0c2",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dirtyoctopus-shop",
      "database_id": "43d6fcfc-293c-467d-bc54-7080e6ffaec4",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "CREATE_LIMITER",
      "namespace_id": "10099",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "GLOBAL_CREATE_LIMITER",
      "namespace_id": "10100",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
}
