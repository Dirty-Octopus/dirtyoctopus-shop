{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dirtyoctopus-shop-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api.dirtyoctopus.net", "custom_domain": true }],
  "assets": {
    "directory": "./dist-worker",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": {
    "ENVIRONMENT": "production",
    "ACCESS_TEAM_DOMAIN": "https://REPLACE_ME.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_ME",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dirtyoctopus-shop",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "CREATE_LIMITER",
      "namespace_id": "10099",
      "simple": { "limit": 5, "period": 60 },
    },
    {
      "name": "GLOBAL_CREATE_LIMITER",
      "namespace_id": "10100",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
}
