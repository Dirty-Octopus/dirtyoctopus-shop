ton>\n        </div>\n        <div class=\"system-switch-row\">\n          <span>INTERFACE SOUND<small>交互音效</small></span\n          ><button id=\"system-sfx\" role=\"switch\" aria-checked=\"true\">ON</button>\n        </div>\n        <div class=\"system-switch-row\">\n          <span>背景音乐</span>\n          <button id=\"system-bgm\" role=\"switch\" aria-checked=\"true\">ON</button>\n        </div>\n        <div class=\"system-switch-row experimental-row\">\n          <span>视角畸变 · 实验性</span>\n          <button id=\"crt-toggle\" role=\"switch\" aria-checked=\"false\">\n            OFF\n          </button>\n        </div>\n        <div class=\"system-section\">\n          <h3>\n            <span>屏幕柔化</span\n            ><output id=\"softness-value\">0.20</output>\n          </h3>\n          <input\n            id=\"softness\"\n            type=\"range\"\n            min=\"0\"\n            max=\"0.8\"\n            step=\"0.05\"\n            value=\"0.2\"\n            aria-label=\"屏幕柔化\"\n          />\n        </div>\n        <div class=\"system-section\">\n          <h3>语言</h3>\n          <div class=\"system-treatments\" role=\"group\" aria-label=\"Language\">\n            <button data-language=\"zh\" aria-pressed=\"true\">中文</button>\n            <button data-language=\"en\" aria-pressed=\"false\">ENGLISH</button>\n          </div>\n        </div>\n        <div class=\"system-section\">\n          <h3>TRANSPORT STATE <span>播放状态</span></h3>\n          <div class=\"system-state\" id=\"system-playback-state\">IDLE / 待机</div>\n        </div>\n        <div class=\"system-section\">\n          <h3>KEYBOARD <span>快捷操作</span></h3>\n          <div class=\"shortcut\"><kbd>SPACE</kbd><span>播放 / 暂停</span></div>\n          <div class=\"shortcut\"><kbd>/</kbd><span>搜索作品</span></div>\n          <div class=\"shortcut\">\n            <kbd>← →</kbd><span>聚焦进度条后精确定位</span>\n          </div>\n          <div class=\"shortcut\">\n            <kbd>ESC</kbd><span>关闭控制台 / 清除搜索</span>\n        